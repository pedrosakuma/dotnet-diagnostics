<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <GenerateProgramFile>false</GenerateProgramFile>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../HttpActivityTarget/HttpActivityTarget.csproj"
                      ReferenceOutputAssembly="false" Private="false"
                      SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="../NetworkingCorrelationTarget/NetworkingCorrelationTarget.csproj"
                      ReferenceOutputAssembly="false" Private="false"
                      SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\..\src\DotnetDiagnostics.Core\DotnetDiagnostics.Core.csproj" />
    <ProjectReference Include="..\..\src\DotnetDiagnostics.Mcp\DotnetDiagnostics.Mcp.csproj" />
    <ProjectReference Include="..\DotnetDiagnostics.TestSupport\DotnetDiagnostics.TestSupport.csproj" />
    <!-- Live tests spawn the sample apps directly. Build them but do not
         reference their assemblies (the tests shell out to `dotnet <dll>`). -->
    <ProjectReference Include="..\..\samples\CoreClrSample\CoreClrSample.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false"
                      SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\..\samples\BadCodeSample\BadCodeSample.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false"
                      SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\RuntimeConfigProbe\RuntimeConfigProbe.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false"
                      SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Compile Include="../NetworkingCorrelationContractFixture.cs" Link="NetworkingCorrelationContractFixture.cs" />
    <Using Include="DotnetDiagnostics.TestSupport" />
  </ItemGroup>

  <!-- Internal Linux worker milestone: no new package/tool deliverable or host activation. -->
  <Target Name="BuildIsolatedCaptureWorkerFixtures" AfterTargets="Build"
          Condition="$([MSBuild]::IsOSPlatform('Linux')) and '$(NETCoreSdkRuntimeIdentifier)' == 'linux-x64'">
    <Exec Command="/usr/bin/cc -std=c11 -O2 -Wall -Wextra -Werror -fstack-protector-strong -D_FORTIFY_SOURCE=2 -Wl,-z,relro,-z,now &quot;$(MSBuildProjectDirectory)/../../src/DotnetDiagnostics.Core/Captures/Isolation/native/capture_worker.c&quot; -ldl -Wl,--no-as-needed -lm -Wl,--as-needed -o &quot;$(TargetDir)capture-worker&quot;" />
    <Exec Command="/usr/bin/cc -std=c11 -O2 -Wall -Wextra -Werror &quot;$(MSBuildProjectDirectory)/Fixtures/Isolation/worker_fixture.c&quot; -o &quot;$(TargetDir)capture-worker-fixture&quot;" />
  </Target>
</Project>
