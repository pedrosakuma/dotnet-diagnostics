{
  "name": "dotnet-diagnostics",
  "displayName": ".NET Diagnostics",
  "description": "Live .NET runtime counters, GC pauses and EventPipe events, CPU, heap and thread snapshots, and dump analysis for running .NET processes, powered by dotnet-diagnostics-cli.",
  "version": "0.4.0",
  "publisher": "pedrosakuma",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#512bd4",
    "theme": "dark"
  },
  "homepage": "https://github.com/pedrosakuma/dotnet-diagnostics/tree/main/vscode-extension#readme",
  "bugs": {
    "url": "https://github.com/pedrosakuma/dotnet-diagnostics/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pedrosakuma/dotnet-diagnostics.git",
    "directory": "vscode-extension"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "Debuggers",
    "Visualization"
  ],
  "keywords": [
    "dotnet",
    ".net",
    "csharp",
    "diagnostics",
    "profiling",
    "performance",
    "eventpipe",
    "gc",
    "counters",
    "heap",
    "dump",
    "threads"
  ],
  "activationEvents": [
    "onCommand:dotnetDiagnostics.startCounters",
    "onCommand:dotnetDiagnostics.stopCounters",
    "onCommand:dotnetDiagnostics.captureCpu",
    "onCommand:dotnetDiagnostics.captureExceptions",
    "onCommand:dotnetDiagnostics.captureDiagnostics",
    "onCommand:dotnetDiagnostics.captureRequestActivities",
    "onCommand:dotnetDiagnostics.captureHeap",
    "onCommand:dotnetDiagnostics.captureThreadSnapshot",
    "onView:dotnetDiagnostics.actions",
    "onView:dotnetDiagnostics.processes",
    "onView:dotnetDiagnostics.history",
    "onCommand:dotnetDiagnostics.checkEnvironment",
    "onCommand:dotnetDiagnostics.copyInstallCommand",
    "onCommand:dotnetDiagnostics.openGettingStarted"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dotnetDiagnostics",
          "title": ".NET Diagnostics",
          "icon": "./resources/diagnostics.svg"
        }
      ]
    },
    "views": {
      "dotnetDiagnostics": [
        {
          "id": "dotnetDiagnostics.actions",
          "name": "Live Diagnostics"
        },
        {
          "id": "dotnetDiagnostics.processes",
          "name": ".NET Processes"
        },
        {
          "id": "dotnetDiagnostics.history",
          "name": "Saved Captures"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "dotnetDiagnostics.processes",
        "contents": "No discoverable .NET processes. Start a .NET application on this extension host, then refresh its diagnostic endpoints.\n[Open Getting Started](command:dotnetDiagnostics.openGettingStarted)\n[Check Environment](command:dotnetDiagnostics.checkEnvironment)\n[Refresh Processes](command:dotnetDiagnostics.refreshProcesses)"
      }
    ],
    "commands": [
      {
        "command": "dotnetDiagnostics.clearProcessFilter",
        "title": ".NET Diagnostics: Clear Process Filter",
        "icon": "$(clear-all)"
      },
      {
        "command": "dotnetDiagnostics.selectProcess",
        "title": ".NET Diagnostics: Select Process"
      },
      {
        "command": "dotnetDiagnostics.refreshProcesses",
        "title": ".NET Diagnostics: Refresh Processes",
        "icon": "$(refresh)"
      },
      {
        "command": "dotnetDiagnostics.filterProcesses",
        "title": ".NET Diagnostics: Filter Processes",
        "icon": "$(filter)"
      },
      {
        "command": "dotnetDiagnostics.refreshHistory",
        "title": ".NET Diagnostics: Refresh Saved Captures",
        "icon": "$(refresh)"
      },
      {
        "command": "dotnetDiagnostics.openCapture",
        "title": ".NET Diagnostics: Open Saved Capture"
      },
      {
        "command": "dotnetDiagnostics.deleteCapture",
        "title": ".NET Diagnostics: Delete Saved Capture",
        "icon": "$(trash)"
      },
      {
        "command": "dotnetDiagnostics.saveSnapshot",
        "title": ".NET Diagnostics: Capture and Save Snapshot"
      },
      {
        "command": "dotnetDiagnostics.startCounters",
        "title": ".NET Diagnostics: Start Live Counters"
      },
      {
        "command": "dotnetDiagnostics.stopCounters",
        "title": ".NET Diagnostics: Stop Live Counters"
      },
      {
        "command": "dotnetDiagnostics.captureCpu",
        "title": ".NET Diagnostics: Capture CPU Now"
      },
      {
        "command": "dotnetDiagnostics.captureCpuTrace",
        "title": ".NET Diagnostics: Capture CPU + raw trace"
      },
      {
        "command": "dotnetDiagnostics.startEvents",
        "title": ".NET Diagnostics: Start Live Events"
      },
      {
        "command": "dotnetDiagnostics.captureExceptions",
        "title": ".NET Diagnostics: Capture Exceptions"
      },
      {
        "command": "dotnetDiagnostics.captureDiagnostics",
        "title": ".NET Diagnostics: Capture Diagnostics"
      },
      {
        "command": "dotnetDiagnostics.captureRequestActivities",
        "title": ".NET Diagnostics: Requests + Completed Activities Reproduction"
      },
      {
        "command": "dotnetDiagnostics.captureHeap",
        "title": ".NET Diagnostics: Capture Heap Snapshot"
      },
      {
        "command": "dotnetDiagnostics.captureThreadSnapshot",
        "title": ".NET Diagnostics: Capture Thread Snapshot"
      },
      {
        "command": "dotnetDiagnostics.analyzeDumpFile",
        "title": ".NET Diagnostics: Analyze Dump File"
      },
      {
        "command": "dotnetDiagnostics.checkEnvironment",
        "title": ".NET Diagnostics: Check Environment"
      },
      {
        "command": "dotnetDiagnostics.copyInstallCommand",
        "title": ".NET Diagnostics: Copy CLI Install Command"
      },
      {
        "command": "dotnetDiagnostics.openGettingStarted",
        "title": ".NET Diagnostics: Open Getting Started"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "dotnetDiagnostics.openGettingStarted",
          "when": "view == dotnetDiagnostics.processes",
          "group": "help"
        },
        {
          "command": "dotnetDiagnostics.checkEnvironment",
          "when": "view == dotnetDiagnostics.processes",
          "group": "help"
        },
        {
          "command": "dotnetDiagnostics.refreshProcesses",
          "when": "view == dotnetDiagnostics.processes",
          "group": "navigation"
        },
        {
          "command": "dotnetDiagnostics.filterProcesses",
          "when": "view == dotnetDiagnostics.processes",
          "group": "navigation"
        },
        {
          "command": "dotnetDiagnostics.refreshHistory",
          "when": "view == dotnetDiagnostics.history",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "dotnetDiagnostics.startCounters",
          "when": "view == dotnetDiagnostics.processes && viewItem == dotnetDiagnostics.process",
          "group": "diagnostics"
        },
        {
          "command": "dotnetDiagnostics.captureCpu",
          "when": "view == dotnetDiagnostics.processes && viewItem == dotnetDiagnostics.process",
          "group": "diagnostics"
        },
        {
          "command": "dotnetDiagnostics.captureHeap",
          "when": "view == dotnetDiagnostics.processes && viewItem == dotnetDiagnostics.process",
          "group": "diagnostics"
        },
        {
          "command": "dotnetDiagnostics.captureThreadSnapshot",
          "when": "view == dotnetDiagnostics.processes && viewItem == dotnetDiagnostics.process",
          "group": "diagnostics"
        },
        {
          "command": "dotnetDiagnostics.saveSnapshot",
          "when": "view == dotnetDiagnostics.processes && viewItem == dotnetDiagnostics.process",
          "group": "save"
        },
        {
          "command": "dotnetDiagnostics.deleteCapture",
          "when": "view == dotnetDiagnostics.history && viewItem == dotnetDiagnostics.savedCapture",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "dotnetDiagnostics.captureCpuTrace",
          "when": "false"
        },
        {
          "command": "dotnetDiagnostics.startEvents",
          "when": "false"
        },
        {
          "command": "dotnetDiagnostics.selectProcess",
          "when": "false"
        },
        {
          "command": "dotnetDiagnostics.openCapture",
          "when": "false"
        },
        {
          "command": "dotnetDiagnostics.deleteCapture",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": ".NET Diagnostics",
      "properties": {
        "dotnetDiagnostics.cliPath": {
          "type": "string",
          "scope": "machine",
          "default": "dotnet-diagnostics-cli",
          "description": "Path to the installed dotnet-diagnostics-cli executable. The extension never installs or updates the tool."
        },
        "dotnetDiagnostics.liveView.historyDurationSeconds": {
          "type": "number",
          "scope": "window",
          "default": 120,
          "minimum": 10,
          "maximum": 3600,
          "description": "How much trailing history (in seconds) the live counters chart and GC pauses table keep visible. Older points/rows are dropped as new ones arrive, matching how other real-time diagnostics panels (e.g. vscode-js-profile-flame's realtime view) bound their visible window instead of rendering an entire unbounded session."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "dotnetDiagnostics.gettingStarted",
        "title": "Get started with .NET Diagnostics",
        "description": "Install dotnet-diagnostics-cli, verify your environment, and pick a process to diagnose.",
        "steps": [
          {
            "id": "installCli",
            "title": "Install the CLI",
            "description": "Install dotnet-diagnostics-cli 0.31.0 or later for all features. The extension never installs tools for you.\n[Copy Install Command](command:dotnetDiagnostics.copyInstallCommand)",
            "media": {
              "markdown": "media/walkthrough/install-cli.md"
            }
          },
          {
            "id": "verifyEnvironment",
            "title": "Verify the environment",
            "description": "Check protocol and feature compatibility, host permissions, and target access guidance.\n[Check Environment](command:dotnetDiagnostics.checkEnvironment)",
            "media": {
              "markdown": "media/walkthrough/verify-environment.md"
            }
          },
          {
            "id": "pickProcess",
            "title": "Pick a process",
            "description": "Choose a running .NET process and start live counters.\n[Start Live Counters](command:dotnetDiagnostics.startCounters)",
            "media": {
              "markdown": "media/walkthrough/pick-process.md"
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "media": "npm run compile && node scripts/render-media.cjs",
    "check": "tsc --noEmit -p .",
    "test": "npm run compile && node --test tests/*.test.cjs",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "3.3.2",
    "typescript": "^5.7.2"
  }
}
