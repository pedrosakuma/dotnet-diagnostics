# Ignore everything by default…
*

# …then re-include only what the Dockerfile actually needs.
!global.json
!Directory.Build.props
!Directory.Packages.props
!.editorconfig
!src/
!samples/
!artifacts/
artifacts/*
!artifacts/portable-worker/
artifacts/portable-worker/*
!artifacts/portable-worker/linux-x64/
artifacts/portable-worker/linux-x64/*
!artifacts/portable-worker/linux-x64/capture-worker
!artifacts/portable-worker/linux-x64/libe_sqlite3.so
!artifacts/portable-worker/linux-x64/provenance.xml
!artifacts/portable-worker/linux-x64/sqlite-LICENSE.txt
!artifacts/portable-worker/linux-x64/worker-LICENSE.txt
!artifacts/portable-worker/linux-arm64/
artifacts/portable-worker/linux-arm64/*
!artifacts/portable-worker/linux-arm64/capture-worker
!artifacts/portable-worker/linux-arm64/libe_sqlite3.so
!artifacts/portable-worker/linux-arm64/provenance.xml
!artifacts/portable-worker/linux-arm64/sqlite-LICENSE.txt
!artifacts/portable-worker/linux-arm64/worker-LICENSE.txt

# Drop build artefacts from any subtree that gets copied.
**/bin/
**/obj/
**/.vs/
**/.idea/
**/*.user
